# Practice progress is stored in browser localStorage and needs no setup.

# Mock tests: Gemini reads uploaded PDFs (server-side only; never exposed to the browser).
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: the Gemini model to use (defaults to gemini-flash-latest).
GEMINI_MODEL=

# Optional: where json-server stores mock tests (defaults to http://localhost:4100; run `npm run db`).
NEXT_PUBLIC_MOCK_API_URL=
