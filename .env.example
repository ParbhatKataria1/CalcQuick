# Database: Upstash Redis stores accounts, practice progress and mock tests.
# On Vercel, connect "Upstash for Redis" under Storage and these are set for you.
# Locally, leave them empty to keep data in .data/ instead, or run `vercel env pull .env.local`.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Mock tests: Gemini reads uploaded PDFs (server-side only; never exposed to the browser).
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional backup keys, comma separated, tried in order when a key runs out of quota or is revoked.
# Each key must be from a different Google Cloud project: keys in one project share its quota.
GEMINI_API_KEYS=
# Optional: the Gemini model to use (defaults to gemini-flash-latest).
GEMINI_MODEL=
# Optional: model tried when the main one is overloaded (defaults to gemini-flash-lite-latest).
GEMINI_FALLBACK_MODEL=

# Vercel Blob: needed on Vercel for PDFs over 4 MB (functions accept 4.5 MB per request).
# Connect a Blob store under Storage and this is set for you. Without it, PDFs are posted directly.
BLOB_READ_WRITE_TOKEN=
# Set to "public" only if the Blob store was created as Public (default: private).
BLOB_ACCESS=
